                <path class="block_xp-footer-red" d="M162.54,16.43V29.26q0,5.55,4.38,5.55t4.39-5.55V16.43h5.16v13a14.47,14.47,0,0,1-.66,4.63,7.85,7.85,0,0,1-2.23,3.14,10.82,10.82,0,0,1-13.29,0A7.87,7.87,0,0,1,158,34a12.72,12.72,0,0,1-.64-4.63V16.43ZM188.18,51H183V16.43h5.17v2.43a9.79,9.79,0,0,1,14.52.35,12.27,12.27,0,0,1,3,8.51,12.1,12.1,0,0,1-3,8.38,9.79,9.79,0,0,1-14.55.18Zm12.28-23.2a7.75,7.75,0,0,0-1.75-5.24,5.64,5.64,0,0,0-4.45-2,5.89,5.89,0,0,0-4.61,2,7.49,7.49,0,0,0-1.77,5.19,7.63,7.63,0,0,0,1.77,5.19,5.79,5.79,0,0,0,4.59,2,5.6,5.6,0,0,0,4.43-2A7.31,7.31,0,0,0,200.46,27.75Z"/>
