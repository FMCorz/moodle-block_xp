</div>
{{#js}}
require(['jquery'], function($) {
    var PREFIX = 'Made with ♥ for ';
    var AUDIENCE_OPTIONS = [
        'course creators',
        'educators',
        'instructional designers',
        'instructors',
        'learning designers',
        'learning teams',
        'lifelong learners',
        'Moodle champions',
        'professors',
        'teachers',
        'trainers',
    ];
    var AFTER_OPTIONS = [
        'And made with ♥ for you too!',
        'And your curious mind.',
        'Still here?',
        'We like that.',
        'Never change.',
        '...',
        'Okay, now you are making me blush.',
        '😊👋'
    ];
    var CHANGE_DELAY = 1000;
    var TYPING_DELAY = 55;

    function shuffle(items) {
        var i;
        var j;
        var tmp;

        for (i = items.length - 1; i > 0; i--) {
            j = Math.floor(Math.random() * (i + 1));
            tmp = items[i];
            items[i] = items[j];
            items[j] = tmp;
        }

        return items;
    }

    function getTooltipElement(element) {
        var tooltipId = element.getAttribute('aria-describedby');
        return tooltipId ? document.getElementById(tooltipId) : null;
    }

    function getVisibleTooltip(element) {
        var tooltip = getTooltipElement(element);

        if (!tooltip) {
            return null;
        }

        return tooltip.classList.contains('show') || tooltip.offsetParent ? tooltip : null;
    }

    function setTooltipText(element, text, updatePosition) {
        var displayText = text || '\u00a0';
        var tooltip = getTooltipElement(element);
        var tooltipInner = tooltip ? tooltip.querySelector('.tooltip-inner') : null;

        element.setAttribute('data-original-title', displayText);
        element.setAttribute('data-bs-original-title', displayText);

        if (tooltipInner) {
            tooltipInner.textContent = displayText;
        }

        if (updatePosition) {
            try {
                $(element).tooltip('update');
            } catch (e) {
                // Some themes redeclare Bootstrap and do not support every tooltip method.
            }
        }
    }

    function createRotator(element) {
        var STATUS_DISPLAYED = 'displayed';
        var STATUS_ERASING = 'erasing';
        var STATUS_DISPLAYING = 'displaying';

        var steps = [];
        var stepIndex = 0;
        var firstAfterStepIndex = 0;
        var stepStatus = STATUS_DISPLAYED;
        var currentText = '';
        var timeoutId = null;
        var isRotating = false;
        var isComplete = false;

        function clearTimer() {
            if (timeoutId) {
                window.clearTimeout(timeoutId);
                timeoutId = null;
            }
        }

        function buildSteps() {
            var audienceOptions = shuffle(AUDIENCE_OPTIONS.slice());
            var newSteps = [];
            var i;

            if (!audienceOptions.length) {
                audienceOptions.push('educators');
            }

            for (i = 0; i < audienceOptions.length; i++) {
                newSteps.push({
                    text: PREFIX + audienceOptions[i],
                    updatePosition: false
                });
            }

            firstAfterStepIndex = newSteps.length;

            for (i = 0; i < AFTER_OPTIONS.length; i++) {
                newSteps.push({
                    text: AFTER_OPTIONS[i],
                    updatePosition: true
                });
            }

            return newSteps;
        }

        function resetAudience() {
            steps = buildSteps();
            stepIndex = 0;
            stepStatus = STATUS_DISPLAYED;
            currentText = steps[stepIndex].text;
            setTooltipText(element, currentText, false);
        }

        function scheduleNext(delay, callback) {
            clearTimer();

            if (!isRotating || !getVisibleTooltip(element) || isComplete) {
                return;
            }

            timeoutId = window.setTimeout(callback, delay);
        }

        function completeRotation() {
            isComplete = true;
            isRotating = false;
            clearTimer();
        }

        function eraseStep() {
            var previousStep = steps[stepIndex - 1];
            var currentStep = steps[stepIndex];
            var eraseLength = previousStep && currentStep && !previousStep.updatePosition && !currentStep.updatePosition
                ? PREFIX.length
                : 0;

            if (!isRotating || !getVisibleTooltip(element)) {
                return;
            }

            if (currentText.length <= eraseLength) {
                stepStatus = STATUS_DISPLAYING;
                displayStep();
                return;
            }

            currentText = currentText.slice(0, -1);
            setTooltipText(element, currentText, steps[stepIndex].updatePosition);
            scheduleNext(TYPING_DELAY, eraseStep);
        }

        function displayStep() {
            var step = steps[stepIndex];

            if (!isRotating || !getVisibleTooltip(element)) {
                return;
            }

            if (currentText.length >= step.text.length) {
                currentText = step.text;
                stepStatus = STATUS_DISPLAYED;
                setTooltipText(element, currentText, step.updatePosition);
                runStep();
                return;
            }

            currentText = step.text.slice(0, currentText.length + 1);
            setTooltipText(element, currentText, step.updatePosition);
            scheduleNext(TYPING_DELAY, displayStep);
        }

        function runStep() {
            if (!isRotating || !getVisibleTooltip(element) || isComplete) {
                return;
            }

            if (stepStatus === STATUS_DISPLAYED) {
                if (stepIndex >= firstAfterStepIndex && stepIndex >= steps.length - 1) {
                    completeRotation();
                    return;
                }

                scheduleNext(CHANGE_DELAY, function() {
                    if (stepIndex >= steps.length - 1) {
                        completeRotation();
                        return;
                    }

                    stepIndex++;
                    stepStatus = STATUS_ERASING;
                    runStep();
                });
                return;
            }

            if (stepStatus === STATUS_ERASING) {
                eraseStep();
                return;
            }

            if (stepStatus === STATUS_DISPLAYING) {
                displayStep();
            }
        }

        function stopRotation() {
            isRotating = false;
            clearTimer();

            if (!isComplete && stepIndex < firstAfterStepIndex) {
                resetAudience();
            }
        }

        function startRotation() {
            if (isRotating || isComplete) {
                return;
            }

            isRotating = true;
            runStep();
        }

        resetAudience();

        return {
            start: startRotation,
            stop: stopRotation
        };
    }

    function init(attempt) {
        var element = document.getElementById('block_xp-tooltip-{{uniqid}}');
        if (!element) {
            return;
        }


        if (element.getAttribute('data-block-xp-footer-tooltip-ready')) {
            return;
        }

        // Is Tooltip initialised yet?
        if (!$(element).tooltip) {
            setTimeout(function() {
                var n = attempt + 1;
                if (n > 25) {
                    return;
                }
                init(n);
            }, 100);
            return;
        }

        element.setAttribute('data-block-xp-footer-tooltip-ready', '1');

        var rotator = createRotator(element);
        $(element)
            .on('shown.bs.tooltip', rotator.start)
            .on('hidden.bs.tooltip', rotator.stop);
    }
    init(0);
});
{{/js}}
