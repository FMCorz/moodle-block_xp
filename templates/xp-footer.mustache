{{!
    @template block_xp/xp-footer

    Level Up XP footer logo.

    Example context (json):
    {
    }
}}
<div class="xp-flex xp-justify-center xp-mt-12">
    <div>
    <svg class="block_xp-footer-logo block_xp-footer-tooltip" xmlns="http://www.w3.org/2000/svg"
        id="block_xp-tooltip-{{uniqid}}"
        viewBox="0 0 205.73 50.95"
        role="img"
        aria-hidden="true"
        tabindex="0"
        data-toggle="tooltip"
        data-bs-toggle="tooltip"
        data-container="false"
        data-bs-container="false"
        data-placement="top"
        data-bs-placement="top"
        data-delay="700"
        data-bs-delay="700"
        data-offset="0,10"
        data-bs-offset="0,10"
        data-template='<div class="block_xp tooltip" role="tooltip"><div class="arrow"></div><div class="tooltip-inner !xp-whitespace-nowrap !xp-max-w-none"></div></div>'
        data-bs-template='<div class="block_xp tooltip" role="tooltip"><div class="tooltip-arrow"></div><div class="tooltip-inner !xp-whitespace-nowrap !xp-max-w-none"></div></div>'
        data-original-title="Made with ♥ for educators"
        data-bs-original-title="Made with ♥ for educators"
        aria-label="Made with ♥ for educators by Level Up"
    >
        <defs>
            <clipPath id="block_xp-footer-wordmark-clip" clipPathUnits="objectBoundingBox">
                <rect class="block_xp-footer-wordmark-clip-rect" x="0" y="0" width="1" height="1"/>
            </clipPath>
            <style>
                .block_xp-footer-logo {
                    --block-xp-footer-logo-ease: cubic-bezier(.2, .8, .2, 1);
                    display: block;
                    height: 40px;
                    overflow: visible;
                    pointer-events: none;
                    width: 162px;
                }

                .block_xp-footer-logo:focus {
                    outline: none;
                }

                .block_xp-footer-logo:focus-visible {
                    outline: 2px solid #1a161b;
                    outline-offset: 4px;
                }

                .block_xp-footer-logo .block_xp-footer-ink {
                    fill: #1a161b;
                }

                [data-bs-theme="dark"] .block_xp-footer-logo .block_xp-footer-ink {
                    fill: #fff;
                }

                .block_xp-footer-logo .block_xp-footer-white {
                    fill: #fff;
                }

                .block_xp-footer-logo .block_xp-footer-logo-mark {
                    transform-box: view-box;
                    transform-origin: 0 0;
                    pointer-events: none;
                    transform: translateX(40.09%);
                    transition: transform .62s var(--block-xp-footer-logo-ease) .08s;
                }

                .block_xp-footer-logo .block_xp-footer-wordmark {
                    clip-path: url(#block_xp-footer-wordmark-clip);
                    opacity: 0;
                    transform: translateX(-10px);
                    transition:
                        opacity .22s linear .12s,
                        transform .62s var(--block-xp-footer-logo-ease) .08s;
                }

                .block_xp-footer-logo .block_xp-footer-wordmark-clip-rect {
                    transform: scaleX(0);
                    transform-origin: 0 0;
                    transition: transform .62s var(--block-xp-footer-logo-ease) .08s;
                }

                .block_xp-footer-logo .block_xp-footer-red,
                .block_xp-footer-logo .block_xp-footer-spark {
                    fill: #f43737;
                }

                .block_xp-footer-logo .block_xp-footer-star,
                .block_xp-footer-logo .block_xp-footer-spark {
                    transform-box: fill-box;
                    transform-origin: center;
                }

                .block_xp-footer-logo .block_xp-footer-spark {
                    opacity: 0;
                    pointer-events: none;
                }

                .block_xp-footer-logo .block_xp-footer-hitarea {
                    fill: transparent;
                    pointer-events: all;
                    transition:
                        width .62s var(--block-xp-footer-logo-ease) .08s,
                        x .62s var(--block-xp-footer-logo-ease) .08s;
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-hitarea {
                    width: 205.73px;
                    x: 0;
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-logo-mark {
                    transform: translateX(0);
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-wordmark {
                    opacity: 1;
                    transform: translateX(0);
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-wordmark-clip-rect {
                    transform: scaleX(1);
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-star {
                    animation: block_xp-footer-star .76s var(--block-xp-footer-logo-ease) both;
                }

                .block_xp-footer-logo:is(:hover, :focus-visible) .block_xp-footer-spark {
                    animation: block_xp-footer-spark .72s var(--block-xp-footer-logo-ease) both;
                }

                .block_xp-footer-logo .block_xp-footer-spark-a {
                    --block-xp-footer-spark-x: -16px;
                    --block-xp-footer-spark-y: -22px;
                }

                .block_xp-footer-logo .block_xp-footer-spark-b {
                    --block-xp-footer-spark-x: -8px;
                    --block-xp-footer-spark-y: 24px;
                }

                @keyframes block_xp-footer-star {
                    0% {
                        transform: translateX(0) rotate(0deg) scale(1);
                    }

                    45% {
                        transform: translateX(10px) rotate(12deg) scale(1.08);
                    }

                    100% {
                        transform: translateX(0) rotate(0deg) scale(1);
                    }
                }

                @keyframes block_xp-footer-spark {
                    0% {
                        opacity: 0;
                        transform: translate(0, 0) scale(.3);
                    }

                    35% {
                        opacity: 1;
                    }

                    100% {
                        opacity: 0;
                        transform: translate(var(--block-xp-footer-spark-x), var(--block-xp-footer-spark-y)) scale(1);
                    }
                }

                @media (prefers-reduced-motion: reduce) {
                    .block_xp-footer-logo *,
                    .block_xp-footer-logo *::before,
                    .block_xp-footer-logo *::after {
                        animation-duration: .001ms !important;
                        animation-iteration-count: 1 !important;
                        transition-duration: .001ms !important;
                    }
                }
            </style>
        </defs>
        <rect class="block_xp-footer-hitarea" x="80" y="-6" width="48" height="56.95" aria-hidden="true"/>
        <g class="block_xp-footer-logo-mark" aria-hidden="true">
